{
  "name": "night-signals-doomscrolling-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender_routes.mjs",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:model && npm run build",
    "test:unit": "vitest run",
    "test:model": "python scripts/test_model_artifact.py"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dompurify": "^3.4.13",
    "plotly.js-dist-min": "^3.7.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-plotly.js": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/plotly.js": "^3.0.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "axe-core": "^4.13.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
